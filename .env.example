# 复制为 .env 后使用：cp .env.example .env
# .env 已被 .gitignore 忽略，不要把真实密钥提交到仓库。

TRACEDELTA_DB_URL=jdbc:mysql://localhost:3306/tracedelta?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
TRACEDELTA_DB_USER=tracedelta
TRACEDELTA_DB_PASSWORD=tracedelta_dev_pass
TRACEDELTA_MYSQL_ROOT_PASSWORD=root_dev_pass

# 32 字节 Base64 主密钥，用于加密上游 API Key。生成：openssl rand -base64 32
TRACEDELTA_MASTER_KEY=

# JWT 签名密钥，至少 32 个字符。生成：openssl rand -hex 32
TRACEDELTA_JWT_SECRET=

# 种子管理员 admin 的初始密码，请改成自己的
TRACEDELTA_ADMIN_PASSWORD=admin123
